<Window x:Class="DailyReportTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyReportTool"
        xmlns:validators="clr-namespace:DailyReportTool.Validators"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="Daily Report Tool" Height="650" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Today's Date -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding TodayDate}" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,15"/>

        <!-- Email Fields -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Email To:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailToTextBox" 
                     Height="30" 
                     Padding="5"
                     ui:ControlHelper.PlaceholderText="Enter email recipients"/>
            
            <TextBlock Text="CC:" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="EmailCCTextBox" 
                     Height="30" 
                     Padding="5"
                     ui:ControlHelper.PlaceholderText="Enter CC recipients"/>
        </StackPanel>

        <!-- Table Header -->
        <TextBlock Grid.Row="2" 
                   Text="Daily Report Entries" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,10"/>

        <!-- DataGrid for Report Entries -->
        <DataGrid Grid.Row="3" 
                  x:Name="ReportDataGrid"
                  ItemsSource="{Binding ReportEntries}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="True" 
                  CanUserDeleteRows="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                    Binding="{Binding ID}" 
                                    Width="50"/>
                <DataGridTextColumn Header="Delivery Date" 
                                    Binding="{Binding DeliveryDate}" 
                                    Width="120"/>
                <DataGridTextColumn Header="Charged Date" 
                                    Binding="{Binding ChargedDate}" 
                                    Width="120"/>
                <DataGridTextColumn Header="Engagement ID" 
                                    Binding="{Binding EngagementID}" 
                                    Width="120"/>
                <DataGridTextColumn Header="Activity" 
                                    Binding="{Binding Activity}" 
                                    Width="150"/>
                <DataGridTextColumn Header="Account" 
                                    Binding="{Binding Account}" 
                                    Width="120"/>
                <DataGridTextColumn Header="Details" 
                                    Binding="{Binding Details}" 
                                    Width="*"/>
                <DataGridTextColumn Header="Charged" 
                                    Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Charged" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:ChargedValueValidationRule />
                            </Binding.ValidationRules>
                        </Binding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Create Email Button -->
        <Button Grid.Row="4" 
                x:Name="CreateEmailButton"
                Content="Create Email" 
                Width="150" 
                Height="40"
                HorizontalAlignment="Left"
                FontSize="14"
                Click="CreateEmailButton_Click"
                Style="{StaticResource AccentButtonStyle}"/>
    </Grid>
</Window>
